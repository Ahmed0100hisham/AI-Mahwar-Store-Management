<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import com.almahwar.controller.support.Icon?>

<!-- Add / edit a customer; opened in place by CustomersController. -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.almahwar.controller.CustomerFormController"
            fitToWidth="true" styleClass="content-scroll">
    <VBox styleClass="page-content" spacing="16">

        <HBox alignment="CENTER_LEFT" spacing="12">
            <Button text="رجوع" styleClass="btn, btn-secondary, btn-back" onAction="#onBack">
                <graphic><Icon name="back"/></graphic>
            </Button>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label fx:id="titleLabel" styleClass="page-title"/>
                <Label fx:id="subtitleLabel" styleClass="page-subtitle" wrapText="true"/>
            </VBox>
        </HBox>

        <Label fx:id="formAlert" wrapText="true" maxWidth="Infinity" visible="false" managed="false"/>

        <VBox styleClass="card, form-card" spacing="14">
            <Label text="بيانات العميل" styleClass="card-title"/>
            <GridPane hgap="18" vgap="12">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="كود العميل" styleClass="field-label"/>
                    <TextField fx:id="codeField"/>
                    <Label fx:id="codeError"/>
                </VBox>
                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="نوع العميل" styleClass="field-label"/>
                    <ComboBox fx:id="typeCombo" maxWidth="Infinity"/>
                    <Label fx:id="typeError"/>
                </VBox>
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                    <Label text="اسم العميل *" styleClass="field-label"/>
                    <TextField fx:id="nameField" promptText="اسم الشخص أو الشركة"/>
                    <Label fx:id="nameError"/>
                </VBox>
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label text="الهاتف" styleClass="field-label"/>
                    <TextField fx:id="phoneField" promptText="مثال: 9988 7766 أو +971501234567"/>
                    <Label fx:id="phoneError"/>
                    <Label fx:id="phoneWarning" styleClass="field-warning-text" wrapText="true" visible="false" managed="false"/>
                </VBox>
                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <Label text="هاتف آخر" styleClass="field-label"/>
                    <TextField fx:id="phone2Field"/>
                    <Label fx:id="phone2Error"/>
                    <Label fx:id="phone2Warning" styleClass="field-warning-text" wrapText="true" visible="false" managed="false"/>
                </VBox>
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="3">
                    <Label text="المنطقة" styleClass="field-label"/>
                    <TextField fx:id="areaField" promptText="مثال: حولي، الفروانية"/>
                    <Label fx:id="areaError"/>
                </VBox>
                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <Label text="البريد الإلكتروني" styleClass="field-label"/>
                    <TextField fx:id="emailField" nodeOrientation="LEFT_TO_RIGHT"/>
                    <Label fx:id="emailError"/>
                </VBox>
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="2">
                    <Label text="العنوان" styleClass="field-label"/>
                    <TextField fx:id="addressField" promptText="القطعة، الشارع، المبنى"/>
                    <Label fx:id="addressError"/>
                </VBox>
            </GridPane>
        </VBox>

        <!-- Account: only for users who may see customer balances -->
        <VBox fx:id="accountCard" styleClass="card, form-card" spacing="14">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="الحساب" styleClass="card-title"/>
                <Label fx:id="currencyLabel" styleClass="muted"/>
            </HBox>
            <HBox spacing="18">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="حد الائتمان" styleClass="field-label"/>
                    <TextField fx:id="creditLimitField" promptText="0 = نقدي فقط"/>
                    <Label fx:id="creditLimitError"/>
                </VBox>
                <VBox fx:id="openingBox" spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="الرصيد الافتتاحي" styleClass="field-label"/>
                    <HBox spacing="8">
                        <TextField fx:id="openingField" promptText="0.000" HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="openingSideCombo" prefWidth="240" minWidth="220"/>
                    </HBox>
                    <Label fx:id="openingError"/>
                </VBox>
            </HBox>
            <Label fx:id="accountHint" styleClass="muted" wrapText="true"/>
        </VBox>

        <VBox styleClass="card, form-card" spacing="12">
            <Label text="ملاحظات وحالة العميل" styleClass="card-title"/>
            <TextArea fx:id="notesArea" prefRowCount="3" wrapText="true"/>
            <Label fx:id="notesError"/>
            <CheckBox fx:id="activeCheck" text="العميل نشط (يظهر في العمليات الجديدة)" selected="true"/>
        </VBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="saveButton" styleClass="btn, btn-primary, btn-lg" onAction="#onSave"/>
            <Button text="إلغاء" styleClass="btn, btn-secondary, btn-lg" onAction="#onBack"/>
        </HBox>
    </VBox>
</ScrollPane>
