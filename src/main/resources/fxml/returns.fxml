<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import com.almahwar.controller.support.Icon?>

<!-- Returns module: sales returns and purchase returns. The return form and details open in place. -->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:id="pageHost" fx:controller="com.almahwar.controller.ReturnsController" styleClass="module-root">

    <VBox fx:id="listPage" styleClass="page-content" spacing="16">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="المرتجعات" styleClass="page-title"/>
                <Label text="مرتجعات المبيعات والمشتريات مقابل الفواتير الأصلية: المخزون وحسابات العملاء والموردين والخزنة في عملية واحدة."
                       styleClass="page-subtitle" wrapText="true"/>
            </VBox>
            <Button fx:id="newButton" text="إنشاء مرتجع" styleClass="btn, btn-primary" onAction="#onNew">
                <graphic><Icon name="plus"/></graphic>
            </Button>
        </HBox>

        <Label fx:id="listMessage" wrapText="true" maxWidth="Infinity" visible="false" managed="false"/>

        <VBox spacing="12" styleClass="card, module-card" VBox.vgrow="ALWAYS">
            <TabPane fx:id="tabs" styleClass="module-tabs" tabClosingPolicy="UNAVAILABLE">
                <Tab fx:id="salesTab" text="مرتجعات المبيعات"/>
                <Tab fx:id="purchasesTab" text="مرتجعات المشتريات"/>
            </TabPane>
            <FlowPane styleClass="filter-bar" hgap="10" vgap="8">
                <TextField fx:id="searchField" promptText="رقم المرتجع أو الفاتورة الأصلية أو الاسم" prefWidth="240"/>
                <Label text="من" styleClass="muted"/>
                <DatePicker fx:id="fromDate" prefWidth="135"/>
                <Label text="إلى" styleClass="muted"/>
                <DatePicker fx:id="toDate" prefWidth="135"/>
                <Button text="مسح" styleClass="btn, btn-secondary" onAction="#onClearFilters">
                    <graphic><Icon name="filter-off"/></graphic>
                </Button>
            </FlowPane>
            <TableView fx:id="returnsTable" VBox.vgrow="ALWAYS" prefHeight="480" styleClass="returns-table">
                <columns>
                    <TableColumn fx:id="noColumn" text="رقم المرتجع" prefWidth="110"/>
                    <TableColumn minWidth="150" fx:id="dateColumn" text="التاريخ" prefWidth="140"/>
                    <TableColumn fx:id="originalColumn" text="الفاتورة الأصلية" prefWidth="130"/>
                    <TableColumn fx:id="partyColumn" text="العميل / المورد" prefWidth="180"/>
                    <TableColumn fx:id="valueColumn" text="قيمة المرتجع" prefWidth="100"/>
                    <TableColumn fx:id="refundColumn" text="المردود نقدًا" prefWidth="100"/>
                    <TableColumn fx:id="reasonColumn" text="السبب" prefWidth="120"/>
                    <TableColumn fx:id="userColumn" text="المستخدم" prefWidth="110"/>
                </columns>
            </TableView>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="countLabel" styleClass="muted"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="viewButton" text="عرض المرتجع" styleClass="btn, btn-secondary" onAction="#onView"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
