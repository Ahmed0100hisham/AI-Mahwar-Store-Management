<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import com.almahwar.controller.support.Icon?>

<!-- Inventory module: stock balances, manual adjustments, stock movement history. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.almahwar.controller.InventoryController"
      styleClass="page-content, module-root" spacing="16">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="المخزون" styleClass="page-title"/>
            <Label text="أرصدة الأصناف، تسوية المخزون، وسجل كل حركة على الكميات" styleClass="page-subtitle"/>
        </VBox>
        <HBox styleClass="stat-chip" alignment="CENTER_LEFT" spacing="6">
            <Label text="الأصناف النشطة:" styleClass="muted"/>
            <Label fx:id="activeCountLabel" styleClass="stat-value"/>
        </HBox>
        <HBox styleClass="stat-chip, stat-chip-warning" alignment="CENTER_LEFT" spacing="6">
            <Label text="منخفضة المخزون:" styleClass="muted"/>
            <Label fx:id="lowCountLabel" styleClass="stat-value"/>
        </HBox>
    </HBox>

    <TabPane fx:id="tabs" styleClass="module-tabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <!-- ===== Stock balances ===== -->
        <Tab fx:id="stockTab" text="أرصدة المخزون">
            <VBox spacing="12" styleClass="card, module-card">
                <HBox styleClass="filter-bar" spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="stockSearchField" promptText="بحث بالاسم أو الكود أو الباركود"
                               HBox.hgrow="ALWAYS" prefWidth="280" minWidth="160" maxWidth="400"/>
                    <ComboBox fx:id="stockCategoryFilter" prefWidth="160" minWidth="130"/>
                    <CheckBox fx:id="stockLowOnly" text="منخفض المخزون فقط" minWidth="-Infinity"/>
                    <CheckBox fx:id="stockShowInactive" text="إظهار المعطّل" minWidth="-Infinity"/>
                    <Region HBox.hgrow="SOMETIMES"/>
                    <Button text="تحديث" styleClass="btn, btn-secondary" minWidth="-Infinity" onAction="#onRefreshStock">
                        <graphic><Icon name="refresh"/></graphic>
                    </Button>
                </HBox>
                <TableView fx:id="stockTable" VBox.vgrow="ALWAYS" prefHeight="520">
                    <columns>
                        <TableColumn fx:id="stCodeColumn" text="الكود" prefWidth="90"/>
                        <TableColumn fx:id="stNameColumn" text="المنتج" prefWidth="240"/>
                        <TableColumn fx:id="stCategoryColumn" text="القسم" prefWidth="120"/>
                        <TableColumn fx:id="stLocationColumn" text="مكان التخزين" prefWidth="110"/>
                        <TableColumn fx:id="stQuantityColumn" text="الكمية" prefWidth="90"/>
                        <TableColumn fx:id="stUnitColumn" text="الوحدة" prefWidth="70"/>
                        <TableColumn fx:id="stMinimumColumn" text="الحد الأدنى" prefWidth="80"/>
                        <TableColumn fx:id="stStatusColumn" text="حالة المخزون" prefWidth="120"/>
                    </columns>
                </TableView>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="stockCountLabel" styleClass="muted"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="adjustSelectedButton" text="تسوية هذا الصنف" styleClass="btn, btn-primary"
                            onAction="#onAdjustSelected"/>
                    <Button fx:id="historySelectedButton" text="سجل حركات الصنف" styleClass="btn, btn-secondary"
                            onAction="#onHistorySelected"/>
                </HBox>
            </VBox>
        </Tab>

        <!-- ===== Stock adjustment ===== -->
        <Tab fx:id="adjustTab" text="تسوية المخزون">
            <HBox spacing="16" alignment="TOP_LEFT">
                <VBox styleClass="card, form-card" spacing="14" HBox.hgrow="ALWAYS" maxWidth="720">
                    <Label text="تسوية مخزون" styleClass="card-title"/>
                    <Label text="تُستخدم للجرد والتالف وفروق الكميات وتصحيح الإدخال. تُسجَّل كل تسوية باسمك وتاريخها ولا يمكن حذفها."
                           styleClass="muted" wrapText="true"/>

                    <VBox spacing="5">
                        <Label text="المنتج *" styleClass="field-label"/>
                        <TextField fx:id="adjProductField" promptText="ابحث بالاسم أو الكود أو امسح الباركود"/>
                        <Label fx:id="adjProductError"/>
                    </VBox>

                    <!-- Selected product -->
                    <GridPane fx:id="adjProductInfo" styleClass="info-box" hgap="24" vgap="6">
                        <Label text="المنتج" styleClass="muted" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label fx:id="adjInfoName" styleClass="cell-primary" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="الرصيد الحالي" styleClass="muted" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Label fx:id="adjInfoQuantity" styleClass="stat-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label text="الحد الأدنى" styleClass="muted" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <Label fx:id="adjInfoMinimum" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    </GridPane>

                    <VBox spacing="5">
                        <Label text="نوع التسوية *" styleClass="field-label"/>
                        <HBox fx:id="adjTypeBox" styleClass="segmented">
                            <ToggleButton fx:id="adjInToggle" text="إضافة للمخزون (+)" styleClass="segment"/>
                            <ToggleButton fx:id="adjOutToggle" text="خصم من المخزون (−)" styleClass="segment"/>
                        </HBox>
                        <Label fx:id="adjTypeError"/>
                    </VBox>

                    <HBox spacing="18">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="الكمية *" styleClass="field-label"/>
                            <TextField fx:id="adjQuantityField" promptText="0"/>
                            <Label fx:id="adjQuantityError"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="السبب *" styleClass="field-label"/>
                            <ComboBox fx:id="adjReasonCombo" editable="true" maxWidth="Infinity"
                                      promptText="اختر أو اكتب السبب"/>
                            <Label fx:id="adjReasonError"/>
                        </VBox>
                    </HBox>

                    <Label fx:id="adjPreviewLabel" styleClass="preview-text" wrapText="true"/>
                    <Label fx:id="adjAlert" wrapText="true" maxWidth="Infinity" visible="false" managed="false"/>

                    <HBox spacing="10">
                        <Button fx:id="adjSaveButton" text="تنفيذ التسوية" styleClass="btn, btn-primary, btn-lg"
                                onAction="#onSaveAdjustment"/>
                        <Button text="مسح" styleClass="btn, btn-secondary, btn-lg" onAction="#onClearAdjustment">
                            <graphic><Icon name="close"/></graphic>
                        </Button>
                    </HBox>
                </VBox>

                <!-- Guidance -->
                <VBox styleClass="card, guide-card" spacing="12" prefWidth="340" minWidth="260">
                    <Label text="قواعد التسوية" styleClass="card-title"/>
                    <Label styleClass="guide-item" wrapText="true"
                           text="• إضافة للمخزون: عند وجود كمية زائدة في الجرد أو تصحيح إدخال ناقص."/>
                    <Label styleClass="guide-item" wrapText="true"
                           text="• خصم من المخزون: للتالف أو المفقود أو فرق الجرد بالنقص."/>
                    <Label styleClass="guide-item" wrapText="true"
                           text="• لا يمكن أن يصبح رصيد أي صنف بالسالب."/>
                    <Label styleClass="guide-item" wrapText="true"
                           text="• السبب إجباري، ويُسجَّل اسم المستخدم والتاريخ تلقائيًا."/>
                    <Label styleClass="guide-item" wrapText="true"
                           text="• كل تسوية تظهر في &quot;سجل حركات المخزون&quot; ولا يمكن تعديلها أو حذفها؛ للتصحيح أجرِ تسوية عكسية."/>
                </VBox>
            </HBox>
        </Tab>

        <!-- ===== Stock movement history ===== -->
        <Tab fx:id="historyTab" text="سجل حركات المخزون">
            <VBox spacing="12" styleClass="card, module-card">
                <HBox styleClass="filter-bar" spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="hisProductField" promptText="كل المنتجات (ابحث عن منتج)"
                               HBox.hgrow="ALWAYS" prefWidth="260" minWidth="160" maxWidth="380"/>
                    <ComboBox fx:id="hisTypeFilter" prefWidth="175" minWidth="150"/>
                    <Label text="من" styleClass="muted" minWidth="-Infinity"/>
                    <DatePicker fx:id="hisFromDate" prefWidth="145" minWidth="130"/>
                    <Label text="إلى" styleClass="muted" minWidth="-Infinity"/>
                    <DatePicker fx:id="hisToDate" prefWidth="145" minWidth="130"/>
                    <Button text="عرض" styleClass="btn, btn-primary" minWidth="-Infinity" onAction="#onSearchHistory">
                        <graphic><Icon name="view"/></graphic>
                    </Button>
                    <Button text="مسح" styleClass="btn, btn-secondary" minWidth="-Infinity" onAction="#onClearHistory">
                        <graphic><Icon name="filter-off"/></graphic>
                    </Button>
                </HBox>
                <Label fx:id="hisAlert" wrapText="true" maxWidth="Infinity" visible="false" managed="false"/>
                <TableView fx:id="historyTable" VBox.vgrow="ALWAYS" prefHeight="520">
                    <columns>
                        <TableColumn minWidth="150" fx:id="hDateColumn" text="التاريخ" prefWidth="130"/>
                        <TableColumn fx:id="hProductColumn" text="المنتج" prefWidth="200"/>
                        <TableColumn fx:id="hTypeColumn" text="نوع الحركة" prefWidth="120"/>
                        <TableColumn fx:id="hQuantityColumn" text="الكمية" prefWidth="80"/>
                        <TableColumn fx:id="hBeforeColumn" text="قبل" prefWidth="70"/>
                        <TableColumn fx:id="hAfterColumn" text="بعد" prefWidth="70"/>
                        <TableColumn fx:id="hReferenceColumn" text="المرجع" prefWidth="90"/>
                        <TableColumn fx:id="hReasonColumn" text="السبب" prefWidth="150"/>
                        <TableColumn fx:id="hUserColumn" text="المستخدم" prefWidth="110"/>
                    </columns>
                </TableView>
                <Label fx:id="historyCountLabel" styleClass="muted"/>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
