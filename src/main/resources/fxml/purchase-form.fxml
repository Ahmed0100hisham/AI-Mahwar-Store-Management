<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import com.almahwar.controller.support.Icon?>

<!-- New / edit purchase (draft). Opened in place by the purchases module. -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.almahwar.controller.PurchaseFormController"
            fitToWidth="true" styleClass="content-scroll">
    <VBox styleClass="page-content" spacing="16">

        <HBox alignment="CENTER_LEFT" spacing="12">
            <Button text="رجوع" styleClass="btn, btn-secondary, btn-back" onAction="#onBack">
                <graphic><Icon name="back"/></graphic>
            </Button>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label fx:id="titleLabel" styleClass="page-title"/>
                <Label fx:id="subtitleLabel" styleClass="page-subtitle" wrapText="true"/>
            </VBox>
        </HBox>

        <Label fx:id="formAlert" wrapText="true" maxWidth="Infinity" visible="false" managed="false"/>

        <!-- Header -->
        <VBox styleClass="card, form-card" spacing="12">
            <Label text="بيانات الفاتورة" styleClass="card-title"/>
            <GridPane hgap="18" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="40"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="35"/>
                </columnConstraints>
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="المورد *" styleClass="field-label"/>
                    <ComboBox fx:id="supplierCombo" promptText="اختر المورد" maxWidth="Infinity"/>
                    <Label fx:id="supplierError"/>
                </VBox>
                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="رقم فاتورة المورد" styleClass="field-label"/>
                    <TextField fx:id="supplierInvoiceField" promptText="كما هو في فاتورة المورد"/>
                    <Label fx:id="supplierInvoiceError"/>
                </VBox>
                <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <Label text="ملاحظات" styleClass="field-label"/>
                    <TextField fx:id="notesField"/>
                    <Label fx:id="notesError"/>
                </VBox>
            </GridPane>
        </VBox>

        <!-- Items -->
        <VBox styleClass="card, form-card" spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="الأصناف" styleClass="card-title"/>
                <Label fx:id="itemsCountLabel" styleClass="count-badge"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="productField" promptText="أضف صنفًا: اكتب الاسم أو الكود أو امسح الباركود ثم Enter"
                           HBox.hgrow="ALWAYS"/>
            </HBox>
            <TableView fx:id="itemsTable" prefHeight="300" minHeight="220" styleClass="lines-table">
                <columns>
                    <TableColumn fx:id="lineNoColumn" text="#" prefWidth="40" sortable="false"/>
                    <TableColumn fx:id="productColumn" text="الصنف" prefWidth="250" sortable="false"/>
                    <TableColumn fx:id="unitColumn" text="الوحدة" prefWidth="70" sortable="false"/>
                    <TableColumn fx:id="quantityColumn" text="الكمية" prefWidth="100" sortable="false"/>
                    <TableColumn fx:id="costColumn" text="سعر الشراء" prefWidth="110" sortable="false"/>
                    <TableColumn fx:id="discountColumn" text="الخصم" prefWidth="100" sortable="false"/>
                    <TableColumn fx:id="lineTotalColumn" text="الإجمالي" prefWidth="110" sortable="false"/>
                    <TableColumn fx:id="removeColumn" text="" prefWidth="60" sortable="false"/>
                </columns>
            </TableView>
            <Label fx:id="itemsError"/>
        </VBox>

        <!-- Totals & payment -->
        <HBox spacing="16">
            <VBox styleClass="card, form-card" spacing="12" HBox.hgrow="ALWAYS">
                <Label text="الدفع" styleClass="card-title"/>
                <HBox spacing="14">
                    <VBox spacing="5" HBox.hgrow="ALWAYS" minWidth="190">
                        <Label text="طريقة الدفع *" styleClass="field-label"/>
                        <ComboBox fx:id="paymentTypeCombo" maxWidth="Infinity"/>
                        <Label fx:id="paymentTypeError"/>
                    </VBox>
                    <VBox fx:id="partialMethodBox" spacing="5" HBox.hgrow="ALWAYS" minWidth="190">
                        <Label text="طريقة دفع المبلغ المدفوع" styleClass="field-label"/>
                        <ComboBox fx:id="partialMethodCombo" maxWidth="Infinity"/>
                        <Label fx:id="partialMethodError"/>
                    </VBox>
                    <VBox fx:id="paidBox" spacing="5" HBox.hgrow="ALWAYS" minWidth="150">
                        <Label text="المبلغ المدفوع" styleClass="field-label"/>
                        <TextField fx:id="paidField" promptText="0.000"/>
                        <Label fx:id="paidError"/>
                    </VBox>
                </HBox>
                <Label fx:id="paymentHint" styleClass="muted" wrapText="true"/>
            </VBox>

            <VBox styleClass="card, form-card, totals-card" spacing="8" minWidth="340" prefWidth="360">
                <Label text="الإجماليات (د.ك)" styleClass="card-title"/>
                <HBox styleClass="total-row"><Label text="مجموع الأصناف"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="subtotalLabel" styleClass="total-value"/></HBox>
                <HBox styleClass="total-row" alignment="CENTER_LEFT" spacing="8">
                    <Label text="خصم الفاتورة"/><Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="discountField" promptText="0.000" prefWidth="120" maxWidth="130"/>
                </HBox>
                <Label fx:id="discountError"/>
                <HBox styleClass="total-row, total-main"><Label text="الإجمالي"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="totalLabel" styleClass="total-value"/></HBox>
                <HBox styleClass="total-row"><Label text="المدفوع"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="paidLabel" styleClass="total-value"/></HBox>
                <HBox styleClass="total-row"><Label text="المتبقي (على الحساب)"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="remainingLabel" styleClass="total-value"/></HBox>
            </VBox>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="postButton" text="اعتماد الفاتورة" styleClass="btn, btn-primary, btn-lg" onAction="#onPost"/>
            <Button fx:id="draftButton" text="حفظ كمسودة" styleClass="btn, btn-secondary, btn-lg" onAction="#onSaveDraft">
                <graphic><Icon name="save"/></graphic>
            </Button>
            <Button text="إلغاء" styleClass="btn, btn-secondary, btn-lg" onAction="#onBack"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="postHint" styleClass="muted" wrapText="true" maxWidth="520"/>
        </HBox>
    </VBox>
</ScrollPane>
