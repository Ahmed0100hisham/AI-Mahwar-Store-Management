<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import com.almahwar.controller.support.Icon?>

<!-- Users module (admin): accounts list and the permission matrix; the user form opens in place. -->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:id="pageHost" fx:controller="com.almahwar.controller.UsersController" styleClass="module-root">

    <VBox fx:id="listPage" styleClass="page-content" spacing="16">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="المستخدمون" styleClass="page-title"/>
                <Label text="حسابات الدخول وأدوارها؛ المستخدم لا يُحذف بل يُعطَّل حتى تبقى سجلاته ومستنداته"
                       styleClass="page-subtitle" wrapText="true"/>
            </VBox>
            <Button fx:id="newButton" text="مستخدم جديد" styleClass="btn, btn-primary" onAction="#onNew">
                <graphic><Icon name="person-add"/></graphic>
            </Button>
        </HBox>

        <Label fx:id="listMessage" wrapText="true" maxWidth="Infinity" visible="false" managed="false"/>

        <TabPane fx:id="tabs" styleClass="module-tabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <Tab text="المستخدمون">
                <VBox spacing="12" styleClass="card, module-card">
                    <HBox styleClass="filter-bar" spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="searchField" promptText="اسم المستخدم أو الاسم أو الهاتف" prefWidth="260"/>
                        <ComboBox fx:id="roleFilter" prefWidth="170"/>
                        <ComboBox fx:id="statusFilter" prefWidth="150"/>
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" prefHeight="480">
                        <columns>
                            <TableColumn fx:id="usernameColumn" text="اسم المستخدم" prefWidth="130"/>
                            <TableColumn fx:id="nameColumn" text="الاسم" prefWidth="190"/>
                            <TableColumn fx:id="roleColumn" text="الدور" prefWidth="120"/>
                            <TableColumn fx:id="statusColumn" text="الحالة" prefWidth="200"/>
                            <TableColumn fx:id="lastLoginColumn" text="آخر دخول" prefWidth="140"/>
                            <TableColumn fx:id="createdColumn" text="تاريخ الإنشاء" prefWidth="120"/>
                        </columns>
                    </TableView>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label fx:id="countLabel" styleClass="muted"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="editButton" text="تعديل" styleClass="btn, btn-secondary" onAction="#onEdit">
                            <graphic><Icon name="edit"/></graphic>
                        </Button>
                        <Button fx:id="toggleButton" text="تعطيل" styleClass="btn, btn-secondary" onAction="#onToggle"/>
                        <Button fx:id="unlockButton" text="إلغاء الإيقاف المؤقت" styleClass="btn, btn-secondary" onAction="#onUnlock">
                            <graphic><Icon name="unlock"/></graphic>
                        </Button>
                        <Button fx:id="resetButton" text="إعادة تعيين كلمة المرور" styleClass="btn, btn-secondary" onAction="#onReset">
                            <graphic><Icon name="key"/></graphic>
                        </Button>
                    </HBox>
                </VBox>
            </Tab>
            <Tab text="مصفوفة الصلاحيات">
                <VBox spacing="10" styleClass="card, module-card">
                    <Label text="الصلاحيات الفعلية لكل دور كما يطبّقها النظام (للعرض فقط)." styleClass="muted"/>
                    <TableView fx:id="matrixTable" VBox.vgrow="ALWAYS" prefHeight="520">
                        <columns>
                            <TableColumn fx:id="groupColumn" text="المجموعة" prefWidth="150"/>
                            <TableColumn fx:id="permissionColumn" text="الصلاحية" prefWidth="260"/>
                            <TableColumn fx:id="adminColumn" text="مدير النظام" prefWidth="100"/>
                            <TableColumn fx:id="accountantColumn" text="محاسب" prefWidth="100"/>
                            <TableColumn fx:id="cashierColumn" text="كاشير" prefWidth="100"/>
                            <TableColumn fx:id="storekeeperColumn" text="أمين مخزن" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>
    </VBox>
</StackPane>
