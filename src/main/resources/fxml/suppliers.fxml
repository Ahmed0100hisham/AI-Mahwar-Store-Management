<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import com.almahwar.controller.support.Icon?>

<!-- Suppliers module: list. Details and the add/edit form open in place (supplier-details.fxml, supplier-form.fxml). -->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:id="pageHost" fx:controller="com.almahwar.controller.SuppliersController" styleClass="module-root">

    <VBox fx:id="listPage" styleClass="page-content" spacing="16">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="الموردون" styleClass="page-title"/>
                <Label fx:id="subtitleLabel" styleClass="page-subtitle" wrapText="true"/>
            </VBox>
            <HBox fx:id="payablesChip" styleClass="stat-chip, stat-chip-warning" alignment="CENTER_LEFT" spacing="6">
                <Label text="إجمالي المستحق للموردين:" styleClass="muted"/>
                <Label fx:id="payablesLabel" styleClass="stat-value"/>
            </HBox>
            <Button fx:id="payButton" text="سداد لمورد" styleClass="btn, btn-secondary" onAction="#onPay">
                <graphic><Icon name="payment"/></graphic>
            </Button>
            <Button fx:id="addButton" text="إضافة مورد" styleClass="btn, btn-primary" onAction="#onAdd">
                <graphic><Icon name="plus"/></graphic>
            </Button>
        </HBox>

        <Label fx:id="listMessage" wrapText="true" maxWidth="Infinity" visible="false" managed="false"/>

        <VBox spacing="12" styleClass="card, module-card" VBox.vgrow="ALWAYS">
            <HBox styleClass="filter-bar" spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="بحث بالكود أو الاسم أو الهاتف أو المسؤول"
                           HBox.hgrow="ALWAYS" prefWidth="300" minWidth="160" maxWidth="420"/>
                <ComboBox fx:id="statusFilter" prefWidth="120" minWidth="100"/>
                <CheckBox fx:id="withBalanceFilter" text="لديهم رصيد" minWidth="-Infinity"/>
                <Region HBox.hgrow="SOMETIMES"/>
                <Button text="مسح الفلاتر" styleClass="btn, btn-secondary" minWidth="-Infinity" onAction="#onClearFilters">
                    <graphic><Icon name="filter-off"/></graphic>
                </Button>
            </HBox>

            <TableView fx:id="suppliersTable" VBox.vgrow="ALWAYS" prefHeight="520">
                <columns>
                    <TableColumn fx:id="codeColumn" text="الكود" prefWidth="90"/>
                    <TableColumn fx:id="nameColumn" text="الاسم" prefWidth="230"/>
                    <TableColumn fx:id="contactColumn" text="المسؤول" prefWidth="120"/>
                    <TableColumn fx:id="phoneColumn" text="الهاتف" prefWidth="130"/>
                    <TableColumn fx:id="areaColumn" text="المنطقة / الدولة" prefWidth="130"/>
                    <TableColumn fx:id="balanceColumn" text="الرصيد" prefWidth="110"/>
                    <TableColumn fx:id="statusColumn" text="الحالة" prefWidth="90"/>
                </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="countLabel" styleClass="muted"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="viewButton" text="عرض التفاصيل" styleClass="btn, btn-secondary" onAction="#onView">
                    <graphic><Icon name="view"/></graphic>
                </Button>
                <Button fx:id="editButton" text="تعديل" styleClass="btn, btn-secondary" onAction="#onEdit">
                    <graphic><Icon name="edit"/></graphic>
                </Button>
                <Button fx:id="toggleButton" text="تعطيل" styleClass="btn, btn-secondary" onAction="#onToggleActive"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
