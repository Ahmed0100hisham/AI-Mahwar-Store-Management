<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import com.almahwar.controller.support.Icon?>

<!-- Customer collection (سند قبض) or supplier payment (سند صرف). Opened in place by the customers / suppliers module. -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.almahwar.controller.PartyPaymentController"
            fitToWidth="true" styleClass="content-scroll">
    <VBox styleClass="page-content" spacing="16">

        <HBox alignment="CENTER_LEFT" spacing="12">
            <Button text="رجوع" styleClass="btn, btn-secondary, btn-back" onAction="#onCancel">
                <graphic><Icon name="back"/></graphic>
            </Button>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label fx:id="titleLabel" styleClass="page-title"/>
                <Label fx:id="subtitleLabel" styleClass="page-subtitle" wrapText="true"/>
            </VBox>
        </HBox>

        <Label fx:id="formAlert" wrapText="true" maxWidth="Infinity" visible="false" managed="false"/>

        <HBox spacing="16">
            <VBox styleClass="card, form-card" spacing="12" HBox.hgrow="ALWAYS">
                <Label fx:id="partyCaption" styleClass="card-title"/>
                <ComboBox fx:id="partyCombo" maxWidth="Infinity"/>
                <Label fx:id="partyError"/>
                <GridPane hgap="18" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="34"/>
                        <ColumnConstraints percentWidth="33"/>
                        <ColumnConstraints percentWidth="33"/>
                    </columnConstraints>
                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="المبلغ (د.ك) *" styleClass="field-label"/>
                        <HBox spacing="6">
                            <TextField fx:id="amountField" promptText="0.000" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="fullButton" text="كامل المستحق" styleClass="btn, btn-secondary" minWidth="-Infinity" onAction="#onFullAmount"/>
                        </HBox>
                        <Label fx:id="amountError"/>
                    </VBox>
                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="طريقة الدفع *" styleClass="field-label"/>
                        <ComboBox fx:id="methodCombo" maxWidth="Infinity"/>
                        <Label fx:id="methodError"/>
                    </VBox>
                    <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label text="تاريخ العملية" styleClass="field-label"/>
                        <DatePicker fx:id="datePicker" maxWidth="Infinity"/>
                        <Label fx:id="dateError"/>
                    </VBox>
                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="رقم المرجع (اختياري)" styleClass="field-label"/>
                        <TextField fx:id="referenceField" promptText="رقم عملية كي نت / شيك / تحويل"/>
                        <Label fx:id="referenceError"/>
                    </VBox>
                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.columnSpan="2">
                        <Label text="ملاحظات" styleClass="field-label"/>
                        <TextField fx:id="notesField"/>
                        <Label fx:id="notesError"/>
                    </VBox>
                </GridPane>
            </VBox>

            <VBox styleClass="card, form-card, totals-card" spacing="8" minWidth="320" prefWidth="340">
                <Label text="الحساب" styleClass="card-title"/>
                <HBox styleClass="total-row"><Label fx:id="outstandingCaption"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="outstandingLabel" styleClass="total-value"/></HBox>
                <HBox styleClass="total-row"><Label text="هذه الدفعة"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="paymentLabel" styleClass="total-value"/></HBox>
                <HBox styleClass="total-row, total-main"><Label text="الرصيد بعد الدفعة"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="afterLabel" styleClass="total-value"/></HBox>
                <Label fx:id="effectHint" styleClass="muted" wrapText="true"/>
            </VBox>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="saveButton" styleClass="btn, btn-primary, btn-lg" onAction="#onSave"/>
            <Button text="إلغاء" styleClass="btn, btn-secondary, btn-lg" onAction="#onCancel"/>
        </HBox>
    </VBox>
</ScrollPane>
